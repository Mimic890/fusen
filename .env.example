# Telegram bot token from @BotFather (required).
BOT_TOKEN=
# SQLite database path. docker-compose overrides it with /data/fusen.db.
DB_PATH=data/fusen.db
# Timezone for new users (IANA name).
DEFAULT_TZ=UTC
# debug, info, warn, error
LOG_LEVEL=info
# Comma-separated Telegram user IDs allowed to use the bot. Empty = open to everyone.
ALLOWED_USER_IDS=
